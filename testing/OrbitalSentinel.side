  "tests": [
    {
      "id": "tc01",
      "name": "TC01 Valid login opens dashboard",
      "commands": [
        {
          "id": "tc01-01",
          "comment": "Reset mock data",
          "command": "open",
          "target": "/api/reset",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc01-02",
          "comment": "",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc01-03",
          "comment": "",
