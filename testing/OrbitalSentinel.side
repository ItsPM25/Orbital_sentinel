        {
          "id": "tc04-07",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "id=alertTable",
          "targets": [],
          "value": "30000"
        },
        {
          "id": "tc04-08",
          "comment": "",
          "command": "assertText",
          "target": "id=alertCount",
          "targets": [],
          "value": "8 alerts"
        },
        {
          "id": "tc04-09",
          "comment": "Highest risk first",
