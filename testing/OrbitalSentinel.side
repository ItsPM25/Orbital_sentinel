        },
        {
          "id": "tc04-10b",
          "comment": "",
          "command": "assertText",
          "target": "css=#alertTable tbody tr:nth-child(1) .riskLevel .riskLabel",
          "targets": [],
          "value": "Critical"
        },
        {
          "id": "tc04-11",
          "comment": "Lowest risk last",
          "command": "assertText",
          "target": "css=#alertTable tbody tr:nth-child(8) .alertId",
          "targets": [],
          "value": "ALT-005"
        }
      ]
    },
