        {
          "id": "tc01-05",
          "comment": "",
          "command": "type",
          "target": "id=password",
          "targets": [],
          "value": "sentinel123"
        },
        {
          "id": "tc01-06",
          "comment": "",
          "command": "click",
          "target": "id=loginBtn",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc01-07",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "id=alertTable",
          "targets": [],
          "value": "30000"
        },
        {
